pipeline {
    agent any

    environment {
        PYTHON_VERSION = '3.11'
        VENV_DIR = '.venv'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup Python Environment') {
            steps {
                script {
                    sh '''
                        # Create venv only if it doesn't exist
                        if [ ! -d "${VENV_DIR}" ]; then
                            echo "Creating new venv..."
                            python3 -m venv ${VENV_DIR}
                        else
                            echo "Using existing venv"
                        fi

                        . ${VENV_DIR}/bin/activate
                        echo "Upgrading pip..."
                        pip install --upgrade pip --quiet
                        echo "Installing/updating requirements..."
                        pip install -r requirements.txt --quiet
                    '''
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        flake8 app/ --max-line-length=120 --exclude=__pycache__
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    sh '''
                        . ${VENV_DIR}/bin/activate

                        # Start the FastAPI server in the background
                        echo "Starting FastAPI server..."
                        nohup uvicorn app.main:app --host 127.0.0.1 --port 8000 > /tmp/uvicorn.log 2>&1 &
                        SERVER_PID=$!
                        echo "Server PID: $SERVER_PID"

                        # Wait for server to be ready
                        echo "Waiting for server to start..."
                        for i in {1..30}; do
                            if curl -s http://127.0.0.1:8000/health > /dev/null 2>&1; then
                                echo "✓ Server is ready"
                                break
                            fi
                            echo "Attempt $i/30: Waiting for server..."
                            sleep 1
                        done

                        # Run tests
                        echo "Running integration tests..."
                        pytest test_api.py -v --tb=short || TEST_RESULT=$?

                        # Kill the server
                        echo "Stopping server..."
                        kill $SERVER_PID 2>/dev/null || true
                        sleep 1
                        kill -9 $SERVER_PID 2>/dev/null || true

                        # Exit with test result
                        exit ${TEST_RESULT:-0}
                    '''
                }
            }
        }

        stage('Validate') {
            steps {
                script {
                    sh '''
                        . ${VENV_DIR}/bin/activate
                        python3 -m py_compile app/main.py
                        python3 -m py_compile app/config.py
                        python3 -m py_compile app/routers/instances.py
                        python3 -m py_compile app/models/instance.py
                        python3 -m py_compile app/services/aws_cli.py
                        python3 -m py_compile app/services/db.py
                        python3 -m py_compile app/services/notifications.py
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Build, lint, test, and validation passed successfully!'
        }

        failure {
            echo 'Build failed. Check logs above.'
        }
    }
}
